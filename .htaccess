# Ocultar copias, volcados y documentación interna.
Options -Indexes
<FilesMatch "(?i)\.(sql|bak|log|ini|example|txt)$">
    Require all denied
</FilesMatch>
<Files "robots.txt">
    Require all granted
</Files>
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Mantener las URLs públicas sin extensión que usa la navegación.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
