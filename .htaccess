# Ocultar copias, volcados y documentación interna.
Options -Indexes
<FilesMatch "(?i)\.(sql|bak|log|ini|example|txt)$">
    Require all denied
</FilesMatch>
<Files "robots.txt">
    Require all granted
</Files>
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Un solo host y protocolo en el dominio de producción.
    RewriteCond %{HTTP_HOST} ^nexus-forever\.es$ [NC]
    RewriteRule ^ https://www.nexus-forever.es%{REQUEST_URI} [R=301,L,NE]
    RewriteCond %{HTTP_HOST} ^www\.nexus-forever\.es$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://www.nexus-forever.es%{REQUEST_URI} [R=301,L,NE]

    RewriteRule ^api/events/([0-9]+)$ api/events.php?event_id=$1 [QSA,L]

    # El sitemap antiguo también sirve siempre el XML actualizado.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Redirigir solo las peticiones externas: no crear bucles al reescribir PHP.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ / [R=301,L]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+[^?\ ]+\.php(?:[?\s]) [NC]
    RewriteRule ^(historia|roster|perfil|armeria|calendario|rsp|reclutamiento|logros|galeria|noticias|normas|mazmorras|members|panel|hermandad-wow-forever|world-of-warcraft-forever|horda-wow-forever|alianza-wow-forever|aviso-legal|privacidad|politica-cookies)\.php$ /$1 [R=301,L]
    RewriteRule ^(historia|roster|perfil|armeria|calendario|rsp|reclutamiento|logros|galeria|noticias|normas|mazmorras|members|panel|hermandad-wow-forever|world-of-warcraft-forever|horda-wow-forever|alianza-wow-forever|aviso-legal|privacidad|politica-cookies)/$ /$1 [R=301,L]

    # Mantener las URLs públicas sin extensión que usa la navegación.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
